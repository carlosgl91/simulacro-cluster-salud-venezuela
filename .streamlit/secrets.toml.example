# Copie este archivo como .streamlit/secrets.toml (que está en .gitignore y
# NUNCA debe versionarse: este repositorio es público).
#
# En Streamlit Community Cloud no se sube el archivo: el mismo contenido se
# pega en App settings -> Secrets.
#
# Sin esta variable el tablero lee los CSV de data/, que es como funciona el
# simulacro. Con ella lee Postgres en vivo a través de las vistas
# app.v_tablero_* (ver db/schema/019_vistas_tablero.sql en el repositorio del
# pipeline), que exponen exactamente las mismas columnas.
#
# Use la cadena del rol `tablero_lectura`: es de SOLO LECTURA y solo ve esas
# vistas, nunca las tablas base, `raw` ni `catalogos`. No use aquí la cadena
# de administración de la base.
#
# Puerto 6543 = pooler de Supabase en modo transacción (el que corresponde
# para una aplicación web).
TABLERO_DB_URL = "postgresql://tablero_lectura:CLAVE@HOST:6543/postgres?sslmode=require"
